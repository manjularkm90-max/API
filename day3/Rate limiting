Rate limiting controls how many requests a client can make within a specified time window. It helps protect APIs from excessive traffic and some forms of abuse.

Example policy: allow 100 requests per 15 minutes per client IP. The exact limit depends on your application.

Install the package:
npm install express-rate-limit


Create rate-limit-demo.js:

const express = require("express");
const rateLimit = require("express-rate-limit");

const app = express();

const apiLimiter = rateLimit({
    windowMs: 15 * 60 * 1000,
    limit: 5,
    standardHeaders: "draft-8",
    legacyHeaders: false,
    message: {
        success: false,
        message: "Too many requests. Try again later."
    }
});

app.use("/api", apiLimiter);

app.get("/api/products", (req, res) => {
    res.json({
        success: true,
        message: "Products fetched successfully"
    });
});

app.listen(3000, () => {
    console.log("Rate-limit demo running on port 3000");
});



Run it:
node rate-limit-demo.js


Test GET http://localhost:3000/api/products several times. With this configuration, requests beyond the configured limit in the time window receive 429 Too Many Requests.

Interview point: Rate limiting is useful for protecting APIs, but production deployments behind proxies need correct proxy configuration and a suitable shared rate-limit store when running multiple instances.
2. Filtering, sorting and pagination
A real API may contain thousands of records. Returning all of them in every response can be slow and waste bandwidth.

Common query parameters:
- search — filter by text
- sortBy — choose a sorting field
- order — ascending or descending
- page — page number
- limit — number of results per page
Example URL:
GET /api/products?search=mouse&sortBy=price&order=asc&page=1&limit=5


Create filter-api.js:

const express = require("express");
const app = express();

const products = [
    { id: 1, name: "Keyboard", price: 800 },
    { id: 2, name: "Mouse", price: 400 },
    { id: 3, name: "Monitor", price: 7500 },
    { id: 4, name: "Mouse Pad", price: 200 },
    { id: 5, name: "Headphones", price: 1500 },
    { id: 6, name: "Webcam", price: 1200 }
];

app.get("/api/products", (req, res) => {
    const search = String(req.query.search || "").toLowerCase();
    const sortBy = req.query.sortBy || "id";
    const order = req.query.order || "asc";
    const page = Number(req.query.page || 1);
    const limit = Number(req.query.limit || 3);

    const allowedSortFields = ["id", "name", "price"];

    if (
        !Number.isInteger(page) || page < 1 ||
        !Number.isInteger(limit) || limit < 1 || limit > 50
    ) {
        return res.status(400).json({
            message: "Invalid page or limit"
        });
    }

    if (
        !allowedSortFields.includes(sortBy) ||
        !["asc", "desc"].includes(order)
    ) {
        return res.status(400).json({
            message: "Invalid sorting option"
        });
    }

    // 1. Filter
    let result = products.filter(product =>
        product.name.toLowerCase().includes(search)
    );

    // 2. Sort
    result.sort((a, b) => {
        const comparison =
            typeof a[sortBy] === "string"
                ? a[sortBy].localeCompare(b[sortBy])
                : a[sortBy] - b[sortBy];

        return order === "asc" ? comparison : -comparison;
    });

    // 3. Pagination
    const total = result.length;
    const start = (page - 1) * limit;
    const data = result.slice(start, start + limit);

    res.json({
        success: true,
        total,
        page,
        limit,
        totalPages: Math.ceil(total / limit),
        data
    });
});

app.listen(3000, () => {
    console.log("Filter API running on port 3000");
});



Run:
node filter-api.js


Try these URLs in your browser or Postman:
URL	Result
http://localhost:3000/api/products	First 3 products
http://localhost:3000/api/products?search=mouse	Products with “mouse” in their names
http://localhost:3000/api/products?sortBy=price&order=desc	Highest-priced products first
http://localhost:3000/api/products?page=2&limit=2	Second page, 2 products
http://localhost:3000/api/products?search=mouse&sortBy=price&order=asc	Matching products sorted by price

This example uses an array. A production API normally performs filtering, sorting and pagination in the database.
