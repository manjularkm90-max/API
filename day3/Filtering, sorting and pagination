A real API may contain thousands of records. Returning all of them in every response can be slow and waste bandwidth.

Common query parameters:
- search — filter by text
- sortBy — choose a sorting field
- order — ascending or descending
- page — page number
- limit — number of results per page
Example URL:
GET /api/products?search=mouse&sortBy=price&order=asc&page=1&limit=5


Create filter-api.js:

const express = require("express");
const app = express();

const products = [
    { id: 1, name: "Keyboard", price: 800 },
    { id: 2, name: "Mouse", price: 400 },
    { id: 3, name: "Monitor", price: 7500 },
    { id: 4, name: "Mouse Pad", price: 200 },
    { id: 5, name: "Headphones", price: 1500 },
    { id: 6, name: "Webcam", price: 1200 }
];

app.get("/api/products", (req, res) => {
    const search = String(req.query.search || "").toLowerCase();
    const sortBy = req.query.sortBy || "id";
    const order = req.query.order || "asc";
    const page = Number(req.query.page || 1);
    const limit = Number(req.query.limit || 3);

    const allowedSortFields = ["id", "name", "price"];

    if (
        !Number.isInteger(page) || page < 1 ||
        !Number.isInteger(limit) || limit < 1 || limit > 50
    ) {
        return res.status(400).json({
            message: "Invalid page or limit"
        });
    }

    if (
        !allowedSortFields.includes(sortBy) ||
        !["asc", "desc"].includes(order)
    ) {
        return res.status(400).json({
            message: "Invalid sorting option"
        });
    }

    // 1. Filter
    let result = products.filter(product =>
        product.name.toLowerCase().includes(search)
    );

    // 2. Sort
    result.sort((a, b) => {
        const comparison =
            typeof a[sortBy] === "string"
                ? a[sortBy].localeCompare(b[sortBy])
                : a[sortBy] - b[sortBy];

        return order === "asc" ? comparison : -comparison;
    });

    // 3. Pagination
    const total = result.length;
    const start = (page - 1) * limit;
    const data = result.slice(start, start + limit);

    res.json({
        success: true,
        total,
        page,
        limit,
        totalPages: Math.ceil(total / limit),
        data
    });
});

app.listen(3000, () => {
    console.log("Filter API running on port 3000");
});



Run:
node filter-api.js
